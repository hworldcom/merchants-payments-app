{
  "name": "restaurant-eurc-payments",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0 <27"
  },
  "scripts": {
    "dev:merchant": "pnpm --filter @merchant-payments/merchant-web dev",
    "dev:customer": "pnpm --filter @merchant-payments/customer-mobile start",
    "build": "pnpm --filter @merchant-payments/merchant-web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "5.0.3"
  }
}
